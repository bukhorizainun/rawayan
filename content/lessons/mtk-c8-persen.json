"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"186\" y=\"142\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"208\" y=\"142\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"10\" y=\"164\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"32\" y=\"164\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"54\" y=\"164\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"76\" y=\"164\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"98\" y=\"164\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"120\" y=\"164\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"142\" y=\"164\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"164\" y=\"164\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"186\" y=\"164\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"208\" y=\"164\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"10\" y=\"186\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"32\" y=\"186\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"54\" y=\"186\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"76\" y=\"186\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"98\" y=\"186\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"120\" y=\"186\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"142\" y=\"186\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"164\" y=\"186\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"186\" y=\"186\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"208\" y=\"186\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"10\" y=\"208\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"32\" y=\"208\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"54\" y=\"208\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"76\" y=\"208\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"98\" y=\"208\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"120\" y=\"208\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"142\" y=\"208\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"164\" y=\"208\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"186\" y=\"208\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"208\" y=\"208\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"10\" y=\"10\" width=\"220\" height=\"220\" fill=\"none\" stroke=\"#1b1e2b\" stroke-width=\"2\"/></svg><figcaption>35 dari 100 kotak diarsir: 35% = \\(\\tfrac{35}{100}\\) = 0,35.</figcaption></figure>\n      <ul>\n        <li><b>100%</b> berarti semuanya. Kalau semua 30 siswa hadir, kehadirannya 100%.</li>\n        <li><b>50%</b> berarti setengahnya.</li>\n        <li><b>0%</b> berarti tidak ada sama sekali.</li>\n      </ul>\n      <p>Persen memudahkan kita membandingkan. Nilai 18 dari 24 dan nilai 15 dari 20 sulit dibandingkan langsung. Setelah diubah ke persen, keduanya ternyata sama-sama 75%.</p>"},{"id":"ubah","title":"Pecahan, desimal, dan persen","html":"\n      <p>Satu nilai bisa ditulis dalam tiga bentuk. Hafalkan pasangan yang sering muncul ini:</p>\n      <div class=\"tbl\"><table>\n        <tr><th>Pecahan</th><th>Desimal</th><th>Persen</th></tr>\n        <tr><td>\\(\\tfrac12\\)</td><td>0,5</td><td>50%</td></tr>\n        <tr><td>\\(\\tfrac14\\)</td><td>0,25</td><td>25%</td></tr>\n        <tr><td>\\(\\tfrac34\\)</td><td>0,75</td><td>75%</td></tr>\n        <tr><td>\\(\\tfrac15\\)</td><td>0,2</td><td>20%</td></tr>\n        <tr><td>\\(\\tfrac{1}{10}\\)</td><td>0,1</td><td>10%</td></tr>\n        <tr><td>\\(\\tfrac13\\)</td><td>0,333...</td><td>kira-kira 33,3%</td></tr>\n        <tr><td>1</td><td>1</td><td>100%</td></tr>\n      </table></div>\n      <div class=\"two\">\n        <div class=\"rumus-box\"><span class=\"lbl\">Pecahan → persen</span>jadikan penyebut 100, atau kalikan 100%<br>\\(\\tfrac35 = \\tfrac{60}{100} = 60\\%\\)</div>\n        <div class=\"rumus-box\"><span class=\"lbl\">Desimal ↔ persen</span>kali 100: geser koma 2 tempat ke kanan<br>0,075 = 7,5% · 120% = 1,2</div>\n      </div>\n      <details class=\"cek\"><summary>Coba sendiri: ubah \\(\\tfrac{7}{20}\\) menjadi persen.</summary><p>\\(\\tfrac{7}{20} = \\tfrac{35}{100} = 35\\%\\). Pembilang dan penyebut dikali 5.</p></details>"},{"id":"dari","title":"Menghitung persen dari suatu bilangan","html":"\n      <div class=\"rumus-box\"><span class=\"lbl\">Persen dari bilangan</span>\\(p\\% \\text{ dari } N = \\dfrac{p}{100} \\times N\\)</div>\n      <div class=\"contoh\"><span class=\"lbl\">Contoh</span><p>Di kelas berisi 32 siswa, 25% datang naik sepeda. Banyaknya \\(\\tfrac{25}{100} \\times 32 = \\tfrac14 \\times 32 = 8\\) siswa.</p></div>\n      <h3>Trik 10%</h3>\n      <p>10% sama dengan sepersepuluh, jadi cukup bagi 10. Dari 10% kita bisa mendapat persen lain dengan cepat.</p>\n      <div class=\"tbl\"><table>\n        <tr><th>Persen dari 250</th><th>Caranya</th><th>Hasil</th></tr>\n        <tr><td>10%</td><td>250 : 10</td><td>25</td></tr>\n        <tr><td>5%</td><td>setengah dari 10%</td><td>12,5</td></tr>\n        <tr><td>20%</td><td>2 × 10%</td><td>50</td></tr>\n        <tr><td>30%</td><td>3 × 10%</td><td>75</td></tr>\n        <tr><td>15%</td><td>10% + 5%</td><td>37,5</td></tr>\n      </table></div>\n      <details class=\"cek\"><summary>Coba sendiri: berapa 35% dari 80?</summary><p>10% dari 80 = 8, jadi 30% = 24 dan 5% = 4. Totalnya 35% = 28.</p></details>"},{"id":"berapa","title":"Mencari persentase","html":"\n      <div class=\"rumus-box\"><span class=\"lbl\">Persentase</span>\\(\\dfrac{\\text{bagian}}{\\text{keseluruhan}} \\times 100\\%\\)</div>\n      <div class=\"contoh\"><span class=\"lbl\">Contoh</span>\n        <p>Dina menjawab benar 18 dari 24 soal. Persentasenya \\(\\tfrac{18}{24} \\times 100\\% = \\tfrac34 \\times 100\\% = 75\\%\\).</p>\n        <p>Kebalikannya juga bisa. Kalau 40% dari suatu bilangan adalah 24, maka 10%-nya 6. Jadi 100% = 60.</p>\n      </div>"},{"id":"diskon","title":"Diskon dan harga yang dibayar","html":"\n      <figure class=\"lesson-fig\"><svg viewBox=\"0 0 560 156\" role=\"img\" aria-label=\"Harga awal Rp150.000, diskon 20 persen sebesar Rp30.000, yang dibayar Rp120.000\"><rect x=\"40\" y=\"30\" width=\"480\" height=\"34\" rx=\"4\" fill=\"#e8eafb\" stroke=\"#3d47c9\"/><text x=\"280\" y=\"52\" text-anchor=\"middle\" font-family=\"Figtree\" font-size=\"13\" font-weight=\"600\" fill=\"#1b1e2b\">harga awal Rp150.000 = 100%</text><rect x=\"40\" y=\"90\" width=\"384\" height=\"34\" rx=\"4\" fill=\"#dcf1ed\" stroke=\"#0f8a7e\"/><text x=\"232\" y=\"112\" text-anchor=\"middle\" font-family=\"Figtree\" font-size=\"13\" font-weight=\"600\" fill=\"#1b1e2b\">dibayar Rp120.000 = 80%</text><rect x=\"424\" y=\"90\" width=\"96\" height=\"34\" rx=\"4\" fill=\"#fbedd5\" stroke=\"#c47a0e\" stroke-dasharray=\"5 4\"/><text x=\"472\" y=\"112\" text-anchor=\"middle\" font-family=\"Figtree\" font-size=\"13\" font-weight=\"600\" fill=\"#c47a0e\">diskon 20%</text><text x=\"472\" y=\"146\" text-anchor=\"middle\" font-family=\"Figtree\" font-size=\"12\" font-weight=\"600\" fill=\"#c47a0e\">Rp30.000</text></svg><figcaption>Diskon 20% berarti yang dibayar 80% dari harga awal.</figcaption></figure>\n      <p>Diskon 20% untuk barang seharga Rp150.000 berarti potongannya 20% × 150.000 = Rp30.000. Yang dibayar 150.000 − 30.000 = Rp120.000.</p>\n      <p>Ada cara yang lebih cepat. Kalau dipotong 20%, yang dibayar tinggal 80%: 80% × 150.000 = Rp120.000.</p>\n      <div class=\"ingat\">Baca soalnya baik-baik: yang ditanyakan <b>besar diskonnya</b> (Rp30.000) atau <b>harga yang dibayar</b> (Rp120.000)?</div>\n      <h3>Diskon bertingkat</h3>\n      <p>Toko menulis \"diskon 30% + 20%\". Banyak orang mengira totalnya 50%. Padahal diskon kedua dihitung dari harga yang sudah turun.</p>\n      <div class=\"contoh\"><span class=\"lbl\">Contoh</span><p>Harga Rp100.000. Setelah diskon 30%, harganya Rp70.000. Diskon 20% dari Rp70.000 adalah Rp14.000, jadi yang dibayar Rp56.000. Total potongannya Rp44.000, atau 44%, bukan 50%.</p></div>\n      <div data-lab-here></div>"},{"id":"naik","title":"Naik dan turun dalam persen","html":"\n      <div class=\"rumus-box\"><span class=\"lbl\">Persen perubahan</span>\\(\\dfrac{\\text{nilai baru} - \\text{nilai awal}}{\\text{nilai awal}} \\times 100\\%\\)</div>\n      <div class=\"contoh\"><span class=\"lbl\">Contoh</span>\n        <p>Harga cabai naik dari Rp40.000 menjadi Rp50.000 per kg. Kenaikannya Rp10.000, jadi \\(\\tfrac{10.000}{40.000} \\times 100\\% = 25\\%\\).</p>\n        <p>Kalau kemudian turun dari Rp50.000 ke Rp40.000, penurunannya \\(\\tfrac{10.000}{50.000} \\times 100\\% = 20\\%\\), bukan 25%.</p>\n      </div>\n      <div class=\"ingat\">Persen perubahan selalu dibandingkan dengan <b>nilai awal</b>. Karena nilai awalnya berbeda, naik 25% lalu turun 20% membawa harga kembali ke tempat semula.</div>"},{"id":"data","title":"Persen dalam data","html":"\n      <p>Hasil survei sering ditulis dalam persen, supaya mudah dibandingkan walaupun banyak orangnya berbeda-beda.</p>\n      <figure class=\"lesson-fig\"><svg viewBox=\"0 0 560 240\" role=\"img\" aria-label=\"Diagram lingkaran olahraga kesukaan 40 siswa: sepak bola 18, bulu tangkis 12, renang 10\"><path d=\"M130 120 L130 20 A100 100 0 0 1 160.90169943749476 215.10565162951536Z\" fill=\"#3d47c9\" stroke=\"#fff\" stroke-width=\"2\"/><rect x=\"270\" y=\"40\" width=\"18\" height=\"18\" rx=\"3\" fill=\"#3d47c9\"/><text x=\"298\" y=\"54\" text-anchor=\"start\" font-family=\"Figtree\" font-size=\"13\" font-weight=\"600\" fill=\"#1b1e2b\">sepak bola: 18 siswa (45%)</text><path d=\"M130 120 L160.90169943749476 215.10565162951536 A100 100 0 0 1 30 120.00000000000001Z\" fill=\"#0f8a7e\" stroke=\"#fff\" stroke-width=\"2\"/><rect x=\"270\" y=\"74\" width=\"18\" height=\"18\" rx=\"3\" fill=\"#0f8a7e\"/><text x=\"298\" y=\"88\" text-anchor=\"start\" font-family=\"Figtree\" font-size=\"13\" font-weight=\"600\" fill=\"#1b1e2b\">bulu tangkis: 12 siswa (30%)</text><path d=\"M130 120 L30 120.00000000000001 A100 100 0 0 1 129.99999999999997 20Z\" fill=\"#c47a0e\" stroke=\"#fff\" stroke-width=\"2\"/><rect x=\"270\" y=\"108\" width=\"18\" height=\"18\" rx=\"3\" fill=\"#c47a0e\"/><text x=\"298\" y=\"122\" text-anchor=\"start\" font-family=\"Figtree\" font-size=\"13\" font-weight=\"600\" fill=\"#1b1e2b\">renang: 10 siswa (25%)</text></svg><figcaption>Olahraga kesukaan 40 siswa. Jumlah semua persennya 100%.</figcaption></figure>\n      <p>Seperempat lingkaran sama dengan 25%. Bagian renang, 10 dari 40 siswa, tepat seperempat lingkaran.</p>\n      <div class=\"wawasan\">\n        <p>Lambang % berasal dari para pedagang Italia sekitar 600 tahun lalu. Mereka menyingkat <i>per cento</i> menjadi \"p cento\", lalu lama-kelamaan tulisannya berubah menjadi lambang % yang kita pakai sekarang.</p>\n        <p>Sekitar 71% permukaan Bumi tertutup air. Tetapi hanya sekitar 3% dari seluruh air di Bumi yang berupa air tawar, dan sebagian besarnya membeku di kutub dan gletser. Air bersih yang bisa kita minum ternyata sangat sedikit, jadi gunakan air secukupnya.</p>\n      </div>"},{"id":"salah","title":"Kesalahan yang sering terjadi","html":"\n      <ul>\n        <li>Menjawab besar diskon padahal yang ditanyakan harga yang dibayar, atau sebaliknya.</li>\n        <li>Menjumlahkan diskon bertingkat: 30% + 20% dikira 50%.</li>\n        <li>Menghitung persen kenaikan dari nilai baru, bukan dari nilai awal.</li>\n        <li>Lupa bahwa persen selalu \"dari sesuatu\". 50% dari 10 dan 50% dari 1.000 sangat berbeda.</li>\n      </ul>"}]}