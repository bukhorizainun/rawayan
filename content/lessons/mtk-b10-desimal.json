f\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"186\" y=\"142\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"208\" y=\"142\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"10\" y=\"164\" width=\"22\" height=\"22\" fill=\"#3d47c9\" fill-opacity=\"0.75\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"32\" y=\"164\" width=\"22\" height=\"22\" fill=\"#3d47c9\" fill-opacity=\"0.75\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"54\" y=\"164\" width=\"22\" height=\"22\" fill=\"#3d47c9\" fill-opacity=\"0.75\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"76\" y=\"164\" width=\"22\" height=\"22\" fill=\"#3d47c9\" fill-opacity=\"0.75\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"98\" y=\"164\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"120\" y=\"164\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"142\" y=\"164\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"164\" y=\"164\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"186\" y=\"164\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"208\" y=\"164\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"10\" y=\"186\" width=\"22\" height=\"22\" fill=\"#3d47c9\" fill-opacity=\"0.75\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"32\" y=\"186\" width=\"22\" height=\"22\" fill=\"#3d47c9\" fill-opacity=\"0.75\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"54\" y=\"186\" width=\"22\" height=\"22\" fill=\"#3d47c9\" fill-opacity=\"0.75\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"76\" y=\"186\" width=\"22\" height=\"22\" fill=\"#3d47c9\" fill-opacity=\"0.75\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"98\" y=\"186\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"120\" y=\"186\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"142\" y=\"186\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"164\" y=\"186\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"186\" y=\"186\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"208\" y=\"186\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"10\" y=\"208\" width=\"22\" height=\"22\" fill=\"#3d47c9\" fill-opacity=\"0.75\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"32\" y=\"208\" width=\"22\" height=\"22\" fill=\"#3d47c9\" fill-opacity=\"0.75\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"54\" y=\"208\" width=\"22\" height=\"22\" fill=\"#3d47c9\" fill-opacity=\"0.75\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"76\" y=\"208\" width=\"22\" height=\"22\" fill=\"#3d47c9\" fill-opacity=\"0.75\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"98\" y=\"208\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"120\" y=\"208\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"142\" y=\"208\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"164\" y=\"208\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"186\" y=\"208\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"208\" y=\"208\" width=\"22\" height=\"22\" fill=\"#fff\" fill-opacity=\"1\" stroke=\"#1b1e2b\" stroke-opacity=\".35\"/><rect x=\"10\" y=\"10\" width=\"220\" height=\"220\" fill=\"none\" stroke=\"#1b1e2b\" stroke-width=\"2\"/></svg><figcaption>45 dari 100 kotak diarsir: 0,45. Lihat, 4 kolom penuh (0,4) ditambah 5 kotak (0,05).</figcaption></figure>\n      <div class=\"tbl\"><table>\n        <tr><th>Pecahan</th><th>Desimal</th><th>Dibaca</th></tr>\n        <tr><td>\\(\\tfrac{1}{10}\\)</td><td>0,1</td><td>nol koma satu</td></tr>\n        <tr><td>\\(\\tfrac{7}{10}\\)</td><td>0,7</td><td>nol koma tujuh</td></tr>\n        <tr><td>\\(\\tfrac{25}{100}\\)</td><td>0,25</td><td>nol koma dua lima</td></tr>\n        <tr><td>\\(\\tfrac{3}{100}\\)</td><td>0,03</td><td>nol koma nol tiga</td></tr>\n        <tr><td>\\(1\\tfrac{5}{10}\\)</td><td>1,5</td><td>satu koma lima</td></tr>\n      </table></div>\n      <div class=\"ingat\">\\(\\tfrac{3}{100}\\) ditulis 0,03, bukan 0,3. Angka nol setelah koma menjaga angka 3 tetap di tempat perseratusan.</div>"},{"id":"nilai-tempat","title":"Nilai tempat di belakang koma","html":"\n      <p>Kamu sudah kenal satuan, puluhan, dan ratusan. Di sebelah kanan koma ada tempat-tempat baru yang nilainya makin kecil.</p>\n      <div class=\"tbl\"><table>\n        <tr><th>Puluhan</th><th>Satuan</th><th>,</th><th>Persepuluhan</th><th>Perseratusan</th></tr>\n        <tr><td>2</td><td>3</td><td>,</td><td>4</td><td>5</td></tr>\n        <tr><td>20</td><td>3</td><td></td><td>0,4</td><td>0,05</td></tr>\n      </table></div>\n      <p>Jadi 23,45 = 20 + 3 + 0,4 + 0,05. Setiap kali bergeser satu tempat ke kanan, nilainya menjadi sepersepuluh kali.</p>\n      <div class=\"contoh\"><span class=\"lbl\">Contoh</span><p>Pada 6,82, angka 8 berada di tempat persepuluhan, jadi nilainya 0,8. Angka 2 berada di tempat perseratusan, jadi nilainya 0,02.</p></div>\n      <details class=\"cek\"><summary>Coba sendiri: berapa nilai angka 7 pada bilangan 4,17?</summary><p>Angka 7 di tempat perseratusan, nilainya 0,07.</p></details>"},{"id":"garis","title":"Desimal pada garis bilangan","html":"\n      <p>Di antara 0 dan 1 ada sembilan persepuluhan: 0,1; 0,2; sampai 0,9. Kalau satu ruas di antara dua persepuluhan diperbesar, di dalamnya ada sepuluh perseratusan.</p>\n      <figure class=\"lesson-fig\"><svg viewBox=\"0 0 560 178\" role=\"img\" aria-label=\"Garis bilangan 0 sampai 1; bagian antara 0,7 dan 0,8 diperbesar menjadi sepuluh perseratusan, titik merah di 0,74\"><defs><marker id=\"dz\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"#3d47c9\"/></marker></defs><line x1=\"20\" y1=\"50\" x2=\"540\" y2=\"50\" stroke=\"#1b1e2b\" stroke-width=\"2\"/><line x1=\"30\" y1=\"43\" x2=\"30\" y2=\"57\" stroke=\"#1b1e2b\" stroke-width=\"2.4\"/><text x=\"30\" y=\"76\" text-anchor=\"middle\" font-family=\"Figtree\" font-size=\"12\" font-weight=\"600\" fill=\"#1b1e2b\">0</text><line x1=\"80\" y1=\"43\" x2=\"80\" y2=\"57\" stroke=\"#1b1e2b\" stroke-width=\"1.4\"/><text x=\"80\" y=\"76\" text-anchor=\"middle\" font-family=\"Figtree\" font-size=\"12\" font-weight=\"600\" fill=\"#1b1e2b\">0,1</text><line x1=\"130\" y1=\"43\" x2=\"130\" y2=\"57\" stroke=\"#1b1e2b\" stroke-width=\"1.4\"/><text x=\"130\" y=\"76\" text-anchor=\"middle\" font-family=\"Figtree\" font-size=\"12\" font-weight=\"600\" fill=\"#1b1e2b\">0,2</text><line x1=\"180\" y1=\"43\" x2=\"180\" y2=\"57\" stroke=\"#1b1e2b\" stroke-width=\"1.4\"/><text x=\"180\" y=\"76\" text-anchor=\"middle\" font-family=\"Figtree\" font-size=\"12\" font-weight=\"600\" fill=\"#1b1e2b\">0,3</text><line x1=\"230\" y1=\"43\" x2=\"230\" y2=\"57\" stroke=\"#1b1e2b\" stroke-width=\"1.4\"/><text x=\"230\" y=\"76\" text-anchor=\"middle\" font-family=\"Figtree\" font-size=\"12\" font-weight=\"600\" fill=\"#1b1e2b\">0,4</text><line x1=\"280\" y1=\"43\" x2=\"280\" y2=\"57\" stroke=\"#1b1e2b\" stroke-width=\"1.4\"/><text x=\"280\" y=\"76\" text-anchor=\"middle\" font-family=\"Figtree\" font-size=\"12\" font-weight=\"600\" fill=\"#1b1e2b\">0,5</text><line x1=\"330\" y1=\"43\" x2=\"330\" y2=\"57\" stroke=\"#1b1e2b\" stroke-width=\"1.4\"/><text x=\"330\" y=\"76\" text-anchor=\"middle\" font-family=\"Figtree\" font-size=\"12\" font-weight=\"600\" fill=\"#1b1e2b\">0,6</text><line x1=\"380\" y1=\"43\" x2=\"380\" y2=\"57\" stroke=\"#1b1e2b\" stroke-width=\"1.4\"/><text x=\"380\" y=\"76\" text-anchor=\"middle\" font-family=\"Figtree\" font-size=\"12\" font-weight=\"600\" fill=\"#1b1e2b\">0,7</text><line x1=\"430\" y1=\"43\" x2=\"430\" y2=\"57\" stroke=\"#1b1e2b\" stroke-width=\"1.4\"/><text x=\"430\" y=\"76\" text-anchor=\"middle\" font-family=\"Figtree\" font-size=\"12\" font-weight=\"600\" fill=\"#1b1e2b\">0,8</text><line x1=\"480\" y1=\"43\" x2=\"480\" y2=\"57\" stroke=\"#1b1e2b\" stroke-width=\"1.4\"/><text x=\"480\" y=\"76\" text-anchor=\"middle\" font-family=\"Figtree\" font-size=\"12\" font-weight=\"600\" fill=\"#1b1e2b\">0,9</text><line x1=\"530\" y1=\"43\" x2=\"530\" y2=\"57\" stroke=\"#1b1e2b\" stroke-width=\"2.4\"/><text x=\"530\" y=\"76\" text-anchor=\"middle\" font-family=\"Figtree\" font-size=\"12\" font-weight=\"600\" fill=\"#1b1e2b\">1</text><rect x=\"380\" y=\"40\" width=\"49.99999999999994\" height=\"20\" fill=\"#c47a0e\" fill-opacity=\".25\"/><path d=\"M380 84 L30 124 M429.99999999999994 84 L530 124\" stroke=\"#c47a0e\" stroke-dasharray=\"4 4\"/><line x1=\"20\" y1=\"140\" x2=\"540\" y2=\"140\" stroke=\"#1b1e2b\" stroke-width=\"2\"/><line x1=\"30\" y1=\"133\" x2=\"30\" y2=\"147\" stroke=\"#1b1e2b\" stroke-width=\"2\"/><text x=\"30\" y=\"166\" text-anchor=\"middle\" font-family=\"Figtree\" font-size=\"12\" font-weight=\"600\" fill=\"#1b1e2b\">0,70</text><line x1=\"80.00000000000004\" y1=\"133\" x2=\"80.00000000000004\" y2=\"147\" stroke=\"#1b1e2b\" stroke-width=\"1.2\"/><line x1=\"130.00000000000009\" y1=\"133\" x2=\"130.00000000000009\" y2=\"147\" stroke=\"#1b1e2b\" stroke-width=\"1.2\"/><line x1=\"180.00000000000014\" y1=\"133\" x2=\"180.00000000000014\" y2=\"147\" stroke=\"#1b1e2b\" stroke-width=\"1.2\"/><line x1=\"230.00000000000017\" y1=\"133\" x2=\"230.00000000000017\" y2=\"147\" stroke=\"#1b1e2b\" stroke-width=\"1.2\"/><line x1=\"280.0000000000002\" y1=\"133\" x2=\"280.0000000000002\" y2=\"147\" stroke=\"#1b1e2b\" stroke-width=\"2\"/><text x=\"280.0000000000002\" y=\"166\" text-anchor=\"middle\" font-family=\"Figtree\" font-size=\"12\" font-weight=\"600\" fill=\"#1b1e2b\">0,75</text><line x1=\"330.0000000000003\" y1=\"133\" x2=\"330.0000000000003\" y2=\"147\" stroke=\"#1b1e2b\" stroke-width=\"1.2\"/><line x1=\"380.0000000000003\" y1=\"133\" x2=\"380.0000000000003\" y2=\"147\" stroke=\"#1b1e2b\" stroke-width=\"1.2\"/><line x1=\"429.9999999999998\" y1=\"133\" x2=\"429.9999999999998\" y2=\"147\" stroke=\"#1b1e2b\" stroke-width=\"1.2\"/><line x1=\"479.99999999999983\" y1=\"133\" x2=\"479.99999999999983\" y2=\"147\" stroke=\"#1b1e2b\" stroke-width=\"1.2\"/><line x1=\"529.9999999999999\" y1=\"133\" x2=\"529.9999999999999\" y2=\"147\" stroke=\"#1b1e2b\" stroke-width=\"2\"/><text x=\"529.9999999999999\" y=\"166\" text-anchor=\"middle\" font-family=\"Figtree\" font-size=\"12\" font-weight=\"600\" fill=\"#1b1e2b\">0,80</text><circle cx=\"230.00000000000017\" cy=\"140\" r=\"7\" fill=\"#c2414f\"/><text x=\"230.00000000000017\" y=\"122\" text-anchor=\"middle\" font-family=\"Figtree\" font-size=\"14\" font-weight=\"600\" fill=\"#c2414f\">0,74</text></svg><figcaption>Di antara dua persepuluhan ada sepuluh perseratusan. Titik merah: 0,74.</figcaption></figure>\n      <p>Jadi 0,74 terletak di antara 0,7 dan 0,8, lebih dekat ke 0,7. Hal yang sama berlaku setelah angka 1: di antara 2 dan 3 ada 2,1; 2,2; sampai 2,9.</p>\n      <div data-lab-here></div>"},{"id":"banding","title":"Membandingkan dan mengurutkan","html":"\n      <p>Bandingkan dari angka paling kiri: satuan dulu, lalu persepuluhan, lalu perseratusan.</p>\n      <div class=\"contoh\"><span class=\"lbl\">Contoh</span>\n        <p>Mana yang lebih besar, 0,5 atau 0,45? Banyak anak menjawab 0,45 karena 45 lebih besar dari 5. Padahal 0,5 = 0,50, yaitu 50 perseratus, sedangkan 0,45 hanya 45 perseratus. Jadi <b>0,5 lebih besar</b>.</p>\n        <p>Urutkan 2,3; 2,28; 2,09 dari yang terkecil. Samakan dulu panjangnya: 2,30; 2,28; 2,09. Urutannya 2,09; 2,28; 2,3.</p>\n      </div>\n      <div class=\"ingat\">Menambahkan nol di <b>ujung kanan</b> desimal tidak mengubah nilainya: 0,5 = 0,50. Tetapi nol yang disisipkan <b>setelah koma</b> mengubah nilainya: 0,5 tidak sama dengan 0,05.</div>\n      <p>Untuk menulis daftar desimal, pakai titik koma (;) sebagai pemisah, karena koma sudah dipakai di dalam bilangannya.</p>"},{"id":"pecahan","title":"Desimal dan pecahan senilai","html":"\n      <p>Pecahan yang penyebutnya bisa dijadikan 10 atau 100 mudah diubah menjadi desimal.</p>\n      <div class=\"tbl\"><table>\n        <tr><th>Pecahan</th><th>Dijadikan per 10 atau per 100</th><th>Desimal</th></tr>\n        <tr><td>\\(\\tfrac12\\)</td><td>\\(\\tfrac{5}{10}\\)</td><td>0,5</td></tr>\n        <tr><td>\\(\\tfrac15\\)</td><td>\\(\\tfrac{2}{10}\\)</td><td>0,2</td></tr>\n        <tr><td>\\(\\tfrac14\\)</td><td>\\(\\tfrac{25}{100}\\)</td><td>0,25</td></tr>\n        <tr><td>\\(\\tfrac34\\)</td><td>\\(\\tfrac{75}{100}\\)</td><td>0,75</td></tr>\n        <tr><td>\\(2\\tfrac12\\)</td><td>\\(2\\tfrac{5}{10}\\)</td><td>2,5</td></tr>\n      </table></div>\n      <details class=\"cek\"><summary>Coba sendiri: ubah \\(\\tfrac{3}{5}\\) menjadi desimal.</summary><p>\\(\\tfrac35 = \\tfrac{6}{10} = 0{,}6\\). Pembilang dan penyebut sama-sama dikali 2.</p></details>"},{"id":"hitung","title":"Menjumlah dan mengurang desimal","html":"\n      <p>Kuncinya satu: <b>luruskan komanya</b>, supaya persepuluhan dijumlahkan dengan persepuluhan dan perseratusan dengan perseratusan. Kalau panjangnya berbeda, tambahkan nol di ujung kanan.</p>\n      <div class=\"two\">\n        <div class=\"rumus-box\"><span class=\"lbl\">Menjumlah</span><span class=\"mono\">&nbsp;&nbsp;2,50<br>+ 1,25<br>&nbsp;&nbsp;────<br>&nbsp;&nbsp;3,75</span></div>\n        <div class=\"rumus-box\"><span class=\"lbl\">Mengurang</span><span class=\"mono\">&nbsp;&nbsp;5,0<br>− 1,4<br>&nbsp;&nbsp;───<br>&nbsp;&nbsp;3,6</span></div>\n      </div>\n      <div class=\"contoh\"><span class=\"lbl\">Contoh</span><p>Dina berlari 1,2 km pada pagi hari dan 0,85 km pada sore hari. Jaraknya 1,20 + 0,85 = 2,05 km.</p></div>\n      <div class=\"ingat\">Jangan menjumlah bagian depan dan belakang koma secara terpisah seperti bilangan biasa. 2,5 + 1,25 bukan 3,30, karena 5 persepuluh tidak boleh dijumlahkan dengan 25 perseratus begitu saja.</div>\n      <details class=\"cek\"><summary>Coba sendiri: 4,75 − 2,5 = ?</summary><p>4,75 − 2,50 = 2,25.</p></details>"},{"id":"sekitar","title":"Desimal di sekitar kita","html":"\n      <ul>\n        <li>Suhu tubuh normal sekitar 36,5–37,5 °C. Termometer yang menunjukkan 38,2 °C menandakan demam.</li>\n        <li>Tinggi badanmu mungkin 1,35 m, dan berat sekantong gula 1,5 kg.</li>\n        <li>Botol air mineral besar berisi 1,5 liter.</li>\n        <li>Waktu lari 100 m diukur sampai perseratus detik, misalnya 12,45 detik.</li>\n      </ul>\n      <h3>Membulatkan ke satuan terdekat</h3>\n      <p>Lihat angka persepuluhan. Kalau 5 atau lebih, bulatkan ke atas. Kalau kurang dari 5, bulatkan ke bawah. 36,8 menjadi 37, sedangkan 2,4 menjadi 2.</p>\n      <div class=\"wawasan\">\n        <p>Tahun 1585, Simon Stevin dari Flandria (sekarang Belgia) menulis buku kecil yang mengajak para pedagang memakai bilangan desimal. Menurutnya, menghitung dengan desimal jauh lebih mudah daripada dengan pecahan.</p>\n        <p>Tidak semua negara menulis desimal dengan koma. Di Indonesia, dua koma lima ditulis 2,5. Di negara berbahasa Inggris ditulis 2.5, dengan titik. Jadi kalau kalkulator atau gim menampilkan 2.5, artinya dua koma lima. Sebaliknya, di Indonesia titik dipakai untuk ribuan: 2.500 artinya dua ribu lima ratus.</p>\n      </div>"},{"id":"salah","title":"Kesalahan yang sering terjadi","html":"\n      <ul>\n        <li>Mengira desimal yang angkanya lebih panjang pasti lebih besar, misalnya 0,45 lebih besar dari 0,5.</li>\n        <li>Menulis \\(\\tfrac{3}{100}\\) sebagai 0,3. Yang benar 0,03.</li>\n        <li>Menjumlah tanpa meluruskan koma.</li>\n        <li>Tertukar antara koma (desimal) dan titik (ribuan).</li>\n      </ul>"}]}